# NGR HUB - variáveis de ambiente (modelo)
# Copie este arquivo para .env e preencha com seus valores reais.

# Credenciais da conta MASTER (acesso irrestrito à licença)
NGR_MASTER_EMAIL=seu@email.com
NGR_MASTER_PASS=sua-senha-forte

# Modelo LLM embarcado (opcional - default: models/qwen3-0.6b-abliterated.gguf)
# MODEL_PATH=./models/qwen3-0.6b-abliterated.gguf
# LLM_CONTEXT_SIZE=2048